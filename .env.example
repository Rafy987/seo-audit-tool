# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored. Never commit real keys.

# Google PageSpeed Insights API key (free, no credit card).
# Create one at https://console.cloud.google.com -> APIs & Services -> Credentials.
PAGESPEED_API_KEY=your_pagespeed_api_key_here

# Groq API key for the written report (free, no credit card).
# Create one at https://console.groq.com -> API Keys.
GROQ_API_KEY=your_groq_api_key_here
# Optional: which Groq model to use (default: openai/gpt-oss-20b).
# GROQ_MODEL=openai/gpt-oss-20b

# Optional: "Prepared by" block at the end of the PDF (hidden if none are set).
# These are printed on the PDF, so they are not secret.
# PREPARED_BY_NAME=Your Name
# PREPARED_BY_EMAIL=you@example.com
# PREPARED_BY_URL=https://www.linkedin.com/in/your-profile
